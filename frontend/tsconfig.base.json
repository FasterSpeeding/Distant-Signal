{
  // Strict flags shared by every TypeScript program in frontend/: the app
  // (tsconfig.json), the Node scripts (tsconfig.scripts.json) and the
  // service worker (tsconfig.sw.json). Starts from the "Strict Config
  // Starting Points" guide's tsconfig.base.json; each deviation says why.
  "compilerOptions": {
    "strict": true,
    // Not in strict:
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // An optional prop that may be handed an explicit `undefined` says so
    // (`prop?: T | undefined`); everything else must be omitted, not set
    // to `undefined`.
    "exactOptionalPropertyTypes": true,

    // Module hygiene: code that single-file transpilers (SWC) handle.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,

    // Deliberate relaxation: don't type-check dependencies' .d.ts files.
    "skipLibCheck": true,

    // Leave unused-binding checks to ESLint (supports the _ convention).
    // The two JS-only programs override this: their unused-binding checks
    // predate the ESLint coverage and cost nothing there.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
