/target
/.claude/
/.superpowers/
/.worktrees/

# Local secrets/config for docker-compose. Blanket rule: every `*.env` file
# is ignored (`*` matches a leading dot in gitignore, so this covers a bare
# `.env` as well as `local.env` / `dev.env`, at any depth — including
# `frontend/.env`), and only the committed, placeholder-only templates
# escape it. See `local.env.example` / `dev.env.example` for the documented
# templates that ARE committed, and docker-compose.yml's header for which
# file is passed to `--env-file` in which mode.
*.env
!*.env.example

# Per-developer mise tool overrides (extra tools, local-only settings) --
# untracked so one contributor's own additions here don't leak into
# everyone else's `mise install`.
mise.local.toml

# schedule-sftp's locally-generated SSH host keys (see local.env.example /
# dev.env.example for the one-time `ssh-keygen` setup step) -- a
# developer's own local dev host key must never be committed.
/schedule-sftp-host-keys/
