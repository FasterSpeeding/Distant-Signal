-- GENERATED by scripts/gen-db-grants.py from db-grants.yaml (with the
-- template scripts/db-grants.sql.tpl). DO NOT EDIT: edit db-grants.yaml,
-- then run `uv run scripts/gen-db-grants.py render`.
--
-- Per-service Postgres roles (docs/postgres-app-role.md, Stage 0b; ingest
-- architecture spec §6). Idempotent. Run with psql as a SUPERUSER in the
-- application database, AFTER postgres-roles.sql (it needs the app role):
--
--   psql -X -d distant_signal -v app=distant_signal_app \
--     [-v <role>=<name>] [-v <role>_connection_limit=N] \
--     -f postgres-grants.sql
--
-- Passwords come from the environment (psql's \getenv), one per created
-- role: @@PASSWORD_ENV@@.
--
-- In ONE transaction:
--   1. the group roles (NOLOGIN) and every role whose status is not
--      `planned` (LOGIN, NOSUPERUSER, ..., CONNECTION LIMIT, password);
--   2. memberships: `observed` roles join the app role (they inherit all of
--      its privileges and have none of their own, but may not SET ROLE to
--      it: WITH INHERIT TRUE, SET FALSE, Postgres 16+); `narrow` roles leave it;
--      each role joins its groups (also SET FALSE);
--   3. CONNECT and USAGE on schema public for every created role;
--   4. the groups' grants and each narrow role's grants, after revoking
--      everything else they hold in schema public. Objects that do not
--      exist yet are skipped (a new cluster's initdb run);
--   5. the row policies (db-grants.yaml `row_policies`): each listed one
--      is a RESTRICTIVE policy for its role (FOR ALL, or one per write
--      command for a `{writes: ...}` entry), created or replaced only when
--      missing or different, and a ds_grants_* policy no longer listed is
--      dropped (an unchanged policy takes no ACCESS EXCLUSIVE lock);
--   6. what the app role loses (db-grants.yaml `app_revokes`): every
--      privilege on those tables and EXECUTE on those functions, which
--      postgres-roles.sql's blanket grants gave it again just before.

\set ON_ERROR_STOP on

-- No statement logging in this session (security review L8): the
-- passwords are literals in the set_config call below, so a failing
-- statement (log_min_error_statement), a slow one
-- (log_min_duration_statement) or log_statement = all would otherwise
-- write them to the server log.
SET log_min_error_statement = panic;
SET log_min_duration_statement = -1;
SET log_statement = none;

@@PSQL_DEFAULTS@@

\echo '== postgres-grants.sql: begin'
BEGIN;

-- Settings live only until COMMIT, so the passwords never outlast it.
SELECT
@@SETTINGS@@
\gset ignored_

-- 1. Roles.
\echo '== postgres-grants.sql: 1. roles'
DO $roles$
DECLARE
    app text := current_setting('ds_grants.app');
    r record;
    seen text[] := ARRAY[]::text[];
BEGIN
    IF NOT (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) THEN
        RAISE EXCEPTION 'postgres-grants.sql must run as a superuser, not %',
            current_user;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = app) THEN
        RAISE EXCEPTION 'the app role % does not exist: run postgres-roles.sql first',
            app;
    END IF;
    FOR r IN
        SELECT v.kind, current_setting('ds_grants.' || v.kind) AS name
        FROM @@GROUP_ROWS@@
    LOOP
        IF r.name = app OR r.name = current_user OR r.name = ANY (seen) THEN
            RAISE EXCEPTION 'the % group name % must be a new, separate role',
                r.kind, r.name;
        END IF;
        seen := seen || r.name;
        IF EXISTS (SELECT 1 FROM pg_roles
                   WHERE rolname = r.name AND (rolsuper OR rolcanlogin)) THEN
            RAISE EXCEPTION 'refusing to turn % into a group (a superuser or a login role)',
                r.name;
        END IF;
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r.name) THEN
            EXECUTE format('CREATE ROLE %I', r.name);
        END IF;
        EXECUTE format('ALTER ROLE %I WITH NOLOGIN NOSUPERUSER NOCREATEDB '
                       'NOCREATEROLE NOREPLICATION NOBYPASSRLS', r.name);
    END LOOP;
    FOR r IN
        SELECT v.kind, current_setting('ds_grants.' || v.kind) AS name,
               current_setting('ds_grants.' || v.kind || '_password') AS password,
               current_setting('ds_grants.' || v.kind || '_connection_limit')
                   AS connection_limit
        FROM @@ROLE_ROWS@@
    LOOP
        IF r.name = app OR r.name = current_user OR r.name = ANY (seen) THEN
            RAISE EXCEPTION 'the % role name % must be a new, separate role',
                r.kind, r.name;
        END IF;
        seen := seen || r.name;
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r.name AND rolsuper) THEN
            RAISE EXCEPTION 'refusing to demote existing superuser % (the % role)',
                r.name, r.kind;
        END IF;
        IF r.connection_limit !~ '^(-1|[0-9]+)$' THEN
            RAISE EXCEPTION 'the % role connection limit % is not a whole number',
                r.kind, r.connection_limit;
        END IF;
        IF r.password = '' THEN
            RAISE EXCEPTION 'no password for the % role: set DS_PG_%_PASSWORD',
                r.kind, upper(r.kind);
        END IF;
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r.name) THEN
            EXECUTE format('CREATE ROLE %I', r.name);
        END IF;
        EXECUTE format('ALTER ROLE %I WITH LOGIN NOSUPERUSER NOCREATEDB '
                       'NOCREATEROLE NOREPLICATION NOBYPASSRLS INHERIT '
                       'CONNECTION LIMIT %s', r.name, r.connection_limit);
        EXECUTE format('ALTER ROLE %I PASSWORD %L', r.name, r.password);
    END LOOP;
END
$roles$;

-- 2. Memberships, 3. CONNECT and USAGE.
\echo '== postgres-grants.sql: 2-3. memberships, CONNECT and USAGE'
DO $members$
DECLARE
    app text := current_setting('ds_grants.app');
    app_oid oid := (SELECT oid FROM pg_roles WHERE rolname = app);
    r record;
    member_oid oid;
BEGIN
    FOR r IN
        SELECT v.kind, v.status, current_setting('ds_grants.' || v.kind) AS name
        FROM @@ROLE_ROWS@@
    LOOP
        member_oid := (SELECT oid FROM pg_roles WHERE rolname = r.name);
        IF r.status = 'observed' THEN
            -- INHERIT TRUE: it uses the app role's privileges. SET FALSE
            -- (Postgres 16+): it cannot SET ROLE to the app role, which
            -- would shed the RESTRICTIVE row policies written for it
            -- (security review M1). Re-granting updates an existing
            -- membership's options.
            EXECUTE format('GRANT %I TO %I WITH INHERIT TRUE, SET FALSE',
                           app, r.name);
        ELSIF r.status = 'narrow' AND EXISTS (
            SELECT 1 FROM pg_auth_members
            WHERE roleid = app_oid AND member = member_oid) THEN
            EXECUTE format('REVOKE %I FROM %I', app, r.name);
        END IF;
        EXECUTE format('GRANT CONNECT ON DATABASE %I TO %I',
                       current_database(), r.name);
        EXECUTE format('GRANT USAGE ON SCHEMA public TO %I', r.name);
    END LOOP;
    FOR r IN
        SELECT current_setting('ds_grants.' || v.kind) AS member,
               current_setting('ds_grants.' || v.grp) AS grp
        FROM @@MEMBER_ROWS@@
    LOOP
        -- SET FALSE here too: a group's grants are only ever inherited.
        EXECUTE format('GRANT %I TO %I WITH INHERIT TRUE, SET FALSE',
                       r.grp, r.member);
    END LOOP;
END
$members$;

-- 4. Grants. Everything the groups and the created roles hold in schema
-- public is revoked first, so a grant removed from db-grants.yaml goes
-- away on the next run. Observed roles end with nothing of their own: they
-- use the app role's privileges.
\echo '== postgres-grants.sql: 4. grants'
DO $grants$
DECLARE
    r record;
    grantee text;
BEGIN
    FOR grantee IN
        SELECT current_setting('ds_grants.' || v.kind)
        FROM @@GRANTEE_ROWS@@
    LOOP
        EXECUTE format('REVOKE ALL ON ALL TABLES IN SCHEMA public FROM %I', grantee);
        EXECUTE format('REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM %I', grantee);
        EXECUTE format('REVOKE ALL ON ALL ROUTINES IN SCHEMA public FROM %I', grantee);
    END LOOP;

    IF to_regclass('public._sqlx_migrations') IS NOT NULL THEN
        EXECUTE format('GRANT SELECT ON public._sqlx_migrations TO %I',
                       current_setting('ds_grants.schema_gate'));
    END IF;
    FOR r IN
        SELECT v.tbl
        FROM @@READ_SHARED_ROWS@@
        WHERE to_regclass(format('public.%I', v.tbl)) IS NOT NULL
    LOOP
        EXECUTE format('GRANT SELECT ON public.%I TO %I', r.tbl,
                       current_setting('ds_grants.read_shared'));
    END LOOP;

    -- Narrow roles: exactly their grants.
    FOR r IN
        SELECT v.tbl, current_setting('ds_grants.' || v.kind) AS grantee,
               v.priv, v.cols
        FROM @@TABLE_ROWS@@
        WHERE to_regclass(format('public.%I', v.tbl)) IS NOT NULL
    LOOP
        IF r.cols = '' THEN
            EXECUTE format('GRANT %s ON public.%I TO %I', r.priv, r.tbl, r.grantee);
        ELSE
            EXECUTE format('GRANT %s (%s) ON public.%I TO %I', r.priv,
                (SELECT string_agg(quote_ident(c), ', ')
                 FROM unnest(string_to_array(r.cols, ',')) AS c),
                r.tbl, r.grantee);
        END IF;
    END LOOP;
    FOR r IN
        SELECT v.seq, current_setting('ds_grants.' || v.kind) AS grantee
        FROM @@SEQUENCE_ROWS@@
        WHERE to_regclass(format('public.%I', v.seq)) IS NOT NULL
    LOOP
        EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE public.%I TO %I',
                       r.seq, r.grantee);
    END LOOP;
    FOR r IN
        SELECT v.sig, current_setting('ds_grants.' || v.kind) AS grantee
        FROM @@FUNCTION_ROWS@@
        WHERE to_regprocedure('public.' || v.sig) IS NOT NULL
    LOOP
        EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO %I',
                       to_regprocedure('public.' || r.sig), r.grantee);
    END LOOP;
END
$grants$;

-- 5. Row policies (spec §6.4, D10). Each is RESTRICTIVE, so it narrows its
-- role whatever permissive policy (the table's migration adds one for
-- PUBLIC) or membership (the app role) would otherwise let it see. It
-- takes effect once the table's migration has enabled row-level security.
--
-- CREATE POLICY and DROP POLICY take ACCESS EXCLUSIVE on the table, which
-- waits behind every open transaction that has touched it and blocks every
-- query queued after it (the 2026-10-14 setup Job ran into its deadline on
-- a release that changed no policy). So a policy whose definition is
-- already right is left alone: the steady state takes no lock stronger
-- than a GRANT's. The wanted definition is deparsed on a throwaway TEMP
-- copy of the table's columns (CREATE TABLE ... LIKE takes only ACCESS
-- SHARE), so it compares exactly with the live policy's, however the
-- condition is spelled. Only a ds_grants_* policy that is not listed, or
-- differs (command, role, RESTRICTIVE, USING or WITH CHECK), is dropped,
-- and only a missing or differing one is created.
\echo '== postgres-grants.sql: 5. row policies'
DO $policies$
DECLARE
    r record;
    probe oid;
    want_qual text;
    want_check text;
    wanted text[] := ARRAY[]::text[];
BEGIN
    FOR r IN
        SELECT v.tbl,
               'ds_grants_' || v.kind
                   || CASE WHEN v.cmd = 'ALL' THEN '' ELSE '_' || lower(v.cmd) END AS pol
        FROM @@POLICY_ROWS@@
        WHERE to_regclass(format('public.%I', v.tbl)) IS NOT NULL
    LOOP
        wanted := wanted || format('%I.%I', r.tbl, r.pol);
    END LOOP;
    -- Policies no longer listed.
    FOR r IN
        SELECT p.tablename, p.policyname
        FROM pg_policies p
        WHERE p.schemaname = 'public' AND p.policyname LIKE 'ds\_grants\_%'
          AND format('%I.%I', p.tablename, p.policyname) <> ALL (wanted)
    LOOP
        RAISE NOTICE 'dropping row policy % on % (no longer listed)',
            r.policyname, r.tablename;
        EXECUTE format('DROP POLICY %I ON public.%I', r.policyname, r.tablename);
    END LOOP;
    FOR r IN
        SELECT v.tbl, v.kind, v.cmd, current_setting('ds_grants.' || v.kind) AS grantee,
               v.cond,
               'ds_grants_' || v.kind
                   || CASE WHEN v.cmd = 'ALL' THEN '' ELSE '_' || lower(v.cmd) END AS pol,
               -- FOR ALL: ds_grants_<role>, USING and WITH CHECK. A
               -- writes-only entry: ds_grants_<role>_<command> for INSERT
               -- (WITH CHECK), UPDATE (both) and DELETE (USING); the role's
               -- reads stay unrestricted.
               CASE v.cmd
                   WHEN 'INSERT' THEN format('WITH CHECK (%s)', v.cond)
                   WHEN 'DELETE' THEN format('USING (%s)', v.cond)
                   ELSE format('USING (%s) WITH CHECK (%s)', v.cond, v.cond)
               END AS clauses,
               CASE v.cmd WHEN 'ALL' THEN '*' WHEN 'INSERT' THEN 'a'
                          WHEN 'UPDATE' THEN 'w' WHEN 'DELETE' THEN 'd' END AS polcmd
        FROM @@POLICY_ROWS@@
        WHERE to_regclass(format('public.%I', v.tbl)) IS NOT NULL
    LOOP
        EXECUTE format('CREATE TEMP TABLE ds_grants_policy_probe (LIKE public.%I)', r.tbl);
        probe := 'pg_temp.ds_grants_policy_probe'::regclass;
        EXECUTE format('CREATE POLICY probe ON pg_temp.ds_grants_policy_probe '
                       'AS RESTRICTIVE FOR %s TO %I %s', r.cmd, r.grantee, r.clauses);
        SELECT pg_get_expr(p.polqual, p.polrelid), pg_get_expr(p.polwithcheck, p.polrelid)
        INTO want_qual, want_check
        FROM pg_policy p WHERE p.polrelid = probe;
        DROP TABLE pg_temp.ds_grants_policy_probe;
        IF EXISTS (
            SELECT 1 FROM pg_policy p
            WHERE p.polrelid = format('public.%I', r.tbl)::regclass
              AND p.polname = r.pol
              AND NOT p.polpermissive
              AND p.polcmd = r.polcmd
              AND p.polroles = ARRAY[(SELECT oid FROM pg_roles WHERE rolname = r.grantee)]
              AND pg_get_expr(p.polqual, p.polrelid) IS NOT DISTINCT FROM want_qual
              AND pg_get_expr(p.polwithcheck, p.polrelid) IS NOT DISTINCT FROM want_check)
        THEN
            CONTINUE;
        END IF;
        RAISE NOTICE 'creating row policy % on %', r.pol, r.tbl;
        EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', r.pol, r.tbl);
        EXECUTE format('CREATE POLICY %I ON public.%I AS RESTRICTIVE FOR %s TO %I %s',
                       r.pol, r.tbl, r.cmd, r.grantee, r.clauses);
    END LOOP;
END
$policies$;

-- 6. The app role's revokes (ingest phase 5, release B). postgres-roles.sql
-- grants app DML on every table and EXECUTE on every routine on each run;
-- these held only for the api's /private routes, and app's members (the
-- observed roles) inherit the loss.
\echo '== postgres-grants.sql: 6. app revokes'
DO $app_revokes$
DECLARE
    app text := current_setting('ds_grants.app');
    r record;
BEGIN
    FOR r IN
        SELECT v.tbl
        FROM @@APP_REVOKE_TABLE_ROWS@@
        WHERE to_regclass(format('public.%I', v.tbl)) IS NOT NULL
    LOOP
        EXECUTE format('REVOKE ALL ON public.%I FROM %I', r.tbl, app);
    END LOOP;
    FOR r IN
        SELECT v.sig
        FROM @@APP_REVOKE_FUNCTION_ROWS@@
        WHERE to_regprocedure('public.' || v.sig) IS NOT NULL
    LOOP
        EXECUTE format('REVOKE EXECUTE ON FUNCTION %s FROM %I',
                       to_regprocedure('public.' || r.sig), app);
    END LOOP;
END
$app_revokes$;

\echo '== postgres-grants.sql: commit'
COMMIT;
\echo '== postgres-grants.sql: done'
